    "source": "\"\"\"Generated by the loop's null stub. No edge by construction.\n\nMomentum on the last closed bar of a 15m series, bracketed at\n1.8166/1.9084. On the synthetic generator's pure-noise sessions there is\nnothing for this to find, whatever the parameters, which is exactly why it is\nwhat the correction is calibrated against.\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass Strategy:\n    def setup(self, ctx) -> None:\n        ctx.subscribe(\"15m\")\n\n    def on_bars(self, ctx) -> None:\n        if ctx.position or ctx.working_order_ids:\n            return\n        history = ctx.history(\"15m\")\n        if len(history) < 2:\n            return\n        last = history[-1]\n        if last.close == last.open:\n            return\n        rising = last.close > last.open\n        place = ctx.buy if rising is True else ctx.sell\n        place(size=2, stop_offset=1.8166, target_offset=1.9084, tag=\"entry\")\n\n    def on_fill(self, ctx) -> None:\n        pass\n\n    def on_lifecycle(self, ctx) -> None:\n        pass\n",
