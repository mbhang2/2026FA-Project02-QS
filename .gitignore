# data directory
private_data*
private_data/*

# generated caches; data/manifest.json stays tracked
data/cache/

# Vendor downloads never belong in the tree -- they go to ~/dl/databento/ and
# are uploaded to R2 from there. `ext/` does not exist; this is a guard for the
# habit, because a couple of GiB of tick data plus one `git add -A` is not
# something you undo quickly. See docs/setup/R2_ACCESS.md section 7.
ext/

# Python artifacts
__pycache__/
*.py[cod]

# Quarto / HTML output
*.html

node_modules/*

#environment files
.env*
!.envrc
!.env.example

#scratch files
.scratch*

